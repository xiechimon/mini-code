# mini-code .env — 复制为 .env 并填入你的 key
# 优先级: System.getenv() > .env > ~/.local/share/opencode/auth.json
# 推荐用 .env 注入，不用再 export 环境变量

# --- 本地推理网关（与本机 Claude Code 一致：同网关同 token）---
# provider=anthropic 时 key 读 ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN
# LLM_PROVIDER=anthropic
# LLM_MODEL=qwen3.8-max-0902
# LLM_BASE_URL=http://<你的网关>/v1
# ANTHROPIC_AUTH_TOKEN=sk-...

# --- opencode (推荐) ---
OPENCODE_API_KEY=sk-your-opencode-key
LLM_PROVIDER=opencode-go
LLM_MODEL=kimi-k2.6
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# --- 其他 provider 示例 (按需启用) ---
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# LLM_PROVIDER=minimax-cn
# LLM_MODEL=MiniMax-M2.7
# MINIMAX_CN_API_KEY=sk-api-...

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4
# ANTHROPIC_API_KEY=sk-ant-...

# 可选：覆盖网关地址
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
